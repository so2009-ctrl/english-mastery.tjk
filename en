<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>English Mastery – Англисиро омӯзед</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Crect width='40' height='40' rx='11' fill='%2316a068'/%3E%3Cpath d='M11 9h18a4 4 0 014 4v10a4 4 0 01-4 4H22l-6 5v-5h-5a4 4 0 01-4-4V13a4 4 0 014-4z' fill='white'/%3E%3Cpath d='M16.5 14v10M16.5 14h8M16.5 19h6M16.5 24h8' stroke='%23131b33' stroke-width='2.3' stroke-linecap='round' fill='none'/%3E%3C/svg%3E">
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;800&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* ===== TOKENS: --lv (level colour) changes when the level changes ===== */
:root{--bg:#f1f4fa;--sf:#fff;--ink:#131b33;--mut:#5b6480;--ln:#dde2ee;--lv:#16a068;--mark:#ffd43b;--bad:#d6443c;
--head:"Bricolage Grotesque","Segoe UI",system-ui,sans-serif;--body:"Instrument Sans","Segoe UI",system-ui,sans-serif}
:root[data-lvl="1"]{--lv:#d98a00}
:root[data-lvl="2"]{--lv:#6d4cf0}
:root[data-theme="dark"]{--bg:#0e1220;--sf:#171d31;--ink:#eef1fb;--mut:#9aa4c4;--ln:#29314b}
:root[data-theme="dark"][data-lvl="0"]{--lv:#3ddc97}
:root[data-theme="dark"][data-lvl="1"]{--lv:#ffb938}
:root[data-theme="dark"][data-lvl="2"]{--lv:#a392ff}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth;scroll-padding-top:76px}
body{background:radial-gradient(900px 520px at 88% -4%,color-mix(in srgb,var(--lv) 20%,transparent),transparent),radial-gradient(700px 420px at -5% 30%,color-mix(in srgb,var(--mark) 14%,transparent),transparent),var(--bg);color:var(--ink);font:400 1rem/1.6 var(--body);transition:background .4s,color .4s}
h1,h2,h3{font-family:var(--head);line-height:1.12}
a{color:inherit;text-decoration:none}button{font:inherit;color:inherit;cursor:pointer}
:focus-visible{outline:3px solid var(--lv);outline-offset:3px}
.wrap{width:min(1120px,92%);margin-inline:auto}
section{padding:76px 0}
.sh{margin-bottom:24px;max-width:600px}.sh h2{font-size:clamp(1.8rem,4vw,2.5rem);font-weight:800}
.sh p,.tg{color:var(--mut)}.sh p{margin-top:8px}
.btn{display:inline-block;padding:13px 26px;border-radius:99px;border:0;background:var(--lv);color:#fff;font-weight:600;transition:transform .2s,box-shadow .2s,background .4s}
.btn:hover{transform:translateY(-3px);box-shadow:0 10px 22px -6px var(--lv)}
/* ===== HEADER ===== */
header{position:sticky;top:0;z-index:10;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--ln)}
.nav{display:flex;align-items:center;justify-content:space-between;height:68px}
.logo{font:800 1.3rem var(--head)}.logo span{background:var(--mark);color:#131b33;padding:0 6px;border-radius:6px}
.links{display:flex;gap:26px}.links a{color:var(--mut);font-weight:500;transition:color .2s}.links a:hover{color:var(--ink)}
.tools{display:flex;gap:8px}.ib{width:40px;height:40px;border-radius:50%;border:1px solid var(--ln);background:var(--sf);display:grid;place-items:center}
#menuBtn{display:none}
/* ===== HERO ===== */
.hero{padding:70px 0 40px}.hero .wrap{display:grid;grid-template-columns:1.15fr .85fr;gap:44px;align-items:center}
.hero h1{font-size:clamp(2.4rem,6vw,4.3rem);font-weight:800;letter-spacing:-.02em}
.hero h1 mark{background:var(--mark);color:#131b33;padding:0 .12em;border-radius:8px}
.hero p{color:var(--mut);font-size:1.1rem;margin:18px 0 28px;max-width:500px}
.greet{background:var(--sf);border:1px solid var(--ln);border-radius:24px;padding:34px;text-align:center;transform:rotate(2.5deg);box-shadow:0 26px 50px -22px rgba(19,27,51,.4);animation:bob 5s ease-in-out infinite}
.greet b{display:block;font:800 clamp(2.4rem,6vw,3.6rem) var(--head);color:var(--lv);transition:opacity .35s,transform .35s,color .4s}
.greet b.out{opacity:0;transform:translateY(14px)}.greet small{color:var(--mut)}
@keyframes bob{50%{transform:rotate(2.5deg) translateY(-10px)}}
/* ===== LEVEL CHIPS ===== */
.lvls{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:24px}
.chip{padding:8px 18px;border-radius:99px;border:1px solid var(--ln);background:var(--sf);font-weight:500;transition:all .25s}
.chip:hover{border-color:var(--lv)}.chip.on{background:var(--lv);border-color:var(--lv);color:#fff}
.chip small{opacity:.8;margin-left:4px}
/* ===== LESSONS ===== */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:18px}
.card{background:var(--sf);border:1px solid var(--ln);border-top:4px solid var(--lv);border-radius:14px;padding:22px;display:flex;flex-direction:column;gap:9px;animation:pop .5s both;transition:transform .25s,box-shadow .25s}
.card:hover{transform:translateY(-5px);box-shadow:0 14px 30px -14px rgba(19,27,51,.35)}
@keyframes pop{from{opacity:0;transform:translateY(16px)}}
.card h3{font-size:1.25rem}.card p{font-size:.95rem;flex:1}.card p span{display:block;color:var(--mut);margin-top:4px}
.bar{height:8px;background:var(--ln);border-radius:99px;overflow:hidden}.bar div{height:100%;background:var(--lv);border-radius:99px;transition:width .6s ease,background .4s}
.row{display:flex;justify-content:space-between;align-items:center;font-size:.85rem;color:var(--mut)}
.row button{border:1px solid var(--ln);background:none;border-radius:99px;padding:4px 14px;font-weight:600;transition:all .2s}
.row button:hover{background:var(--lv);border-color:var(--lv);color:#fff}
/* ===== DIALOGUE ===== */
.dlg{max-width:720px;display:grid;gap:12px}
.msg{max-width:84%;padding:12px 16px;border-radius:18px;background:var(--sf);border:1px solid var(--ln);animation:pop .5s both}
.msg:nth-child(even){justify-self:end;background:var(--lv);border-color:var(--lv);color:#fff}
.msg em{display:block;font-style:normal;opacity:.78;font-size:.93rem}
/* ===== FLASHCARDS ===== */
.fg{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:18px}
.fl{perspective:900px;height:250px;background:none;border:0;padding:0;text-align:left}
.fi{position:relative;width:100%;height:100%;transform-style:preserve-3d;transition:transform .6s cubic-bezier(.3,.7,.2,1)}
.fl.flip .fi{transform:rotateY(180deg)}
.fc{position:absolute;inset:0;backface-visibility:hidden;border-radius:14px;padding:20px;display:flex;flex-direction:column;justify-content:center;gap:5px;border:1px solid var(--ln);background:var(--sf)}
.fc.f b{font:800 1.9rem var(--head)}.fc.f i{color:var(--lv)}.fc.f small{color:var(--mut);margin-top:8px}
.fc.b{transform:rotateY(180deg);background:var(--lv);border-color:var(--lv);color:#fff;font-size:.93rem}.fc.b b{font:800 1.6rem var(--head)}
/* ===== QUIZ ===== */
.quiz{background:var(--sf);border:1px solid var(--ln);border-radius:22px;padding:clamp(20px,4vw,38px);max-width:720px}
.qm{display:flex;justify-content:space-between;color:var(--mut);font-size:.9rem;margin-bottom:8px}
.quiz h3{font-size:1.45rem;margin:16px 0 18px}
.opts{display:grid;gap:10px}
.opt{text-align:left;padding:13px 18px;border-radius:12px;border:1.5px solid var(--ln);background:var(--bg);transition:all .2s}
.opt:hover:not(:disabled){border-color:var(--lv);transform:translateX(4px)}
.opt.ok{border-color:#16a068;background:color-mix(in srgb,#16a068 18%,transparent)}
.opt.no{border-color:var(--bad);background:color-mix(in srgb,var(--bad) 15%,transparent);animation:shake .3s}
@keyframes shake{25%{transform:translateX(-5px)}75%{transform:translateX(5px)}}
.fb{min-height:28px;margin:14px 0 6px;font-weight:600}
.score{text-align:center;padding:18px 0}.score b{display:block;font:800 4rem var(--head);color:var(--lv)}
/* ===== FOOTER ===== */
footer{border-top:1px solid var(--ln);padding:40px 0 26px}
.foot{display:flex;justify-content:space-between;gap:28px;flex-wrap:wrap}.foot nav{display:flex;gap:20px;flex-wrap:wrap}
.foot nav a,.copy{color:var(--mut)}.copy{margin-top:28px;font-size:.88rem}
.soc{display:flex;gap:10px}.soc a{width:40px;height:40px;border-radius:50%;border:1px solid var(--ln);display:grid;place-items:center;font-weight:700;transition:all .2s}
.soc a:hover{background:var(--lv);color:#fff;border-color:var(--lv)}
/* ===== NEW: logo, speak, search, instagram, to-top ===== */
.logo{display:flex;align-items:center;gap:9px}.lg{width:36px;height:36px;flex:none;transition:transform .4s}.logo:hover .lg{transform:rotate(-8deg) scale(1.1)}
.sp{cursor:pointer;display:inline-block;margin-left:6px;transition:transform .2s}.sp:hover{transform:scale(1.3)}
.search{width:100%;max-width:420px;padding:12px 18px;margin:0 0 20px;border-radius:99px;border:1.5px solid var(--ln);background:var(--sf);color:var(--ink);font:inherit}.search:focus{border-color:var(--lv);outline:0}
.ig{display:flex;align-items:center;justify-content:space-between;gap:22px;flex-wrap:wrap;color:#fff;border-radius:26px;padding:clamp(24px,5vw,44px);background:linear-gradient(135deg,var(--lv),color-mix(in srgb,var(--lv) 50%,#e1306c))}
.ig h2{font-size:clamp(1.6rem,4vw,2.3rem);font-weight:800}.ig .btn{background:#fff;color:#131b33;display:inline-flex;gap:8px;align-items:center}
.top{position:fixed;right:18px;bottom:18px;width:46px;height:46px;border-radius:50%;border:0;background:var(--lv);color:#fff;font-size:1.3rem;box-shadow:0 8px 20px -6px var(--lv);opacity:0;pointer-events:none;transform:translateY(10px);transition:all .3s;z-index:9}.top.show{opacity:1;pointer-events:auto;transform:none}
.msg{cursor:pointer}.msg .sp{float:right}.ib{transition:all .2s}.ib:hover{background:var(--lv);color:#fff;border-color:var(--lv)}
.chip.on{box-shadow:0 8px 18px -8px var(--lv)}
/* ===== RESPONSIVE ===== */
@media(max-width:820px){.hero .wrap{grid-template-columns:1fr}.greet{animation:none;transform:none}#menuBtn{display:grid}
.links{position:absolute;top:68px;left:0;right:0;background:var(--bg);flex-direction:column;padding:20px;gap:14px;border-bottom:1px solid var(--ln);display:none}
.links.open{display:flex}section{padding:56px 0}.msg{max-width:94%}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style>
</head>
