<script>
/* ===== DATA ===== */
const LV = ["Beginner","Intermediate","Advanced"], LT = ["Ибтидоӣ","Миёна","Олӣ"];

/* Lessons: title | Tajik title | explanation (EN + TJ) | start progress */
const LESSONS = [
 ["Greetings|Салом додан|Hello, Hi, Good morning. “How are you?” = «Шумо чӣ хелед?»|60","To be: am / is / are|Феъли be|I am, you are, he is. «Ман ҳастам» = I am.|30","Numbers 1–10|Рақамҳо|one, two, three … ten = яке то даҳ.|0"],
 ["Past simple|Гузаштаи оддӣ|Add -ed: work → worked. Irregular: go → went (рафт).|50","Present perfect|Ҳозираи мукаммал|have/has + V3: I have finished = Ман тамом кардам.|20","Comparatives|Дараҷаи муқоиса|bigger than, more expensive than = калонтар аз, гаронтар аз.|0"],
 ["Conditionals|Ҷумлаи шартӣ|If I had time, I would study = Агар вақт медоштам, мехондам.|35","Passive voice|Шакли мачҳул|The book was written by him = Китоб аз ҷониби ӯ навишта шуд.|10","Idioms|Ибораҳо|Break a leg = Good luck = Барори кор!|0"]
].map(a=>a.map(s=>{const[t,tj,d,p]=s.split("|");return{t,tj,d,p:+p}}));

/* Dialogues: English|Tajik (speakers alternate A, B) */
const DIA = [
 ["Hello! My name is Ali. What is your name?|Салом! Номи ман Алӣ аст. Номи шумо чист?","Hi Ali! I am Sara. Nice to meet you.|Салом, Алӣ! Ман Сара. Аз шиносоӣ хурсандам.","Where are you from?|Шумо аз куҷо ҳастед?","I am from Tajikistan. And you?|Ман аз Тоҷикистон. Шумо чӣ?","I am from Uzbekistan. I am a student.|Ман аз Ӯзбекистон. Ман донишҷӯ ҳастам.","Great! Let's be friends.|Олӣ! Биёед дӯст шавем."],
 ["Have you decided where to go this summer?|Оё қарор кардед, тобистон ба куҷо меравед?","Not yet. Could you recommend a place?|Ҳанӯз не. Метавонед ягон ҷой тавсия диҳед?","I suggest Samarkand. The journey is short.|Ман Самарқандро пешниҳод мекунам. Сафар кӯтоҳ аст.","Is it expensive?|Оё гарон аст?","Not really. Hotels are comfortable and cheap.|Не чандон. Меҳмонхонаҳо бароҳат ва арзонанд.","Perfect, I will check my schedule.|Олӣ, ман ҷадваламро месанҷам."],
 ["What would you say is your greatest strength?|Тарафи қавии шумо чист?","I'm pragmatic and meticulous about details.|Ман воқеъбин ва дар тафсилот бодиққат ҳастам.","How do you handle ambiguous instructions?|Бо дастурҳои мубҳам чӣ тавр кор мекунед?","I ask questions until the goal is coherent.|Савол медиҳам, то ҳадаф мантиқӣ шавад.","Where do you see yourself in five years?|Дар панҷ сол худро дар куҷо мебинед?","Leading a team and mitigating risks before they become inevitable.|Роҳбарии даста ва сабук кардани хатарҳо пеш аз он ки ногузир шаванд."]
];

/* Words: word|IPA|Tajik|Russian|Uzbek|definition|example (the example must contain the word) */
const WORDS = [[
"apple|ˈæp.əl|себ|яблоко|olma|a round fruit|I eat an apple every day.","book|bʊk|китоб|книга|kitob|pages to read|This book is very good.","water|ˈwɔː.tər|об|вода|suv|clear liquid to drink|I drink water in the morning.","friend|frend|дӯст|друг|do'st|a person you like|She is my best friend.","house|haʊs|хона|дом|uy|a place to live|Our house is near the school.","family|ˈfæm.əl.i|оила|семья|oila|parents and children|I love my family.","school|skuːl|мактаб|школа|maktab|where children learn|I go to school by bus.","happy|ˈhæp.i|хушҳол|счастливый|baxtli|feeling joy|I am happy today.","big|bɪɡ|калон|большой|katta|large in size|He has a big dog.","morning|ˈmɔː.nɪŋ|субҳ|утро|ertalab|early part of the day|Good morning, teacher!","eat|iːt|хӯрдан|есть|yemoq|to take food|We eat dinner at seven.","teacher|ˈtiː.tʃər|муаллим|учитель|o'qituvchi|a person who teaches|My teacher is kind.","city|ˈsɪt.i|шаҳр|город|shahar|a large town|Dushanbe is a big city.","red|red|сурх|красный|qizil|the colour of blood|She wears a red dress.","sleep|sliːp|хоб кардан|спать|uxlamoq|to rest at night|I sleep eight hours.","market|ˈmɑː.kɪt|бозор|рынок|bozor|a place to buy things|We buy fruit at the market.","brother|ˈbrʌð.ər|бародар|брат|aka-uka|a boy in your family|My brother plays football.","night|naɪt|шаб|ночь|tun|the dark part of the day|Good night, mom!"],[
"improve|ɪmˈpruːv|беҳтар кардан|улучшать|yaxshilamoq|to make better|I want to improve my English.","suggest|səˈdʒest|пешниҳод кардан|предлагать|taklif qilmoq|to put forward an idea|I suggest we leave early.","experience|ɪkˈspɪə.ri.əns|таҷриба|опыт|tajriba|knowledge from doing|She has a lot of experience.","decide|dɪˈsaɪd|қарор кардан|решать|qaror qilmoq|to make a choice|We decide together.","expensive|ɪkˈspen.sɪv|гарон|дорогой|qimmat|costing a lot|This phone is too expensive.","comfortable|ˈkʌmf.tə.bəl|бароҳат|удобный|qulay|giving ease|The sofa is comfortable.","environment|ɪnˈvaɪ.rən.mənt|муҳити зист|окружающая среда|atrof-muhit|nature around us|We must protect the environment.","opportunity|ˌɒp.əˈtʃuː.nə.ti|имконият|возможность|imkoniyat|a chance to do something|This job is a great opportunity.","borrow|ˈbɒr.əʊ|қарз гирифтан|одолжить|qarzga olmoq|to take and return later|Can I borrow your pen?","manage|ˈmæn.ɪdʒ|идора кардан|управлять|boshqarmoq|to be in charge|She can manage a team.","attend|əˈtend|иштирок кардан|посещать|qatnashmoq|to be present at|I attend English classes.","neighbour|ˈneɪ.bər|ҳамсоя|сосед|qo'shni|a person next door|My neighbour is friendly.","journey|ˈdʒɜː.ni|сафар|поездка|sayohat|travel from place to place|The journey took two hours.","recommend|ˌrek.əˈmend|тавсия додан|рекомендовать|tavsiya qilmoq|to say something is good|I recommend this book.","attitude|ˈæt.ɪ.tjuːd|муносибат|отношение|munosabat|way of thinking|A positive attitude helps.","achieve|əˈtʃiːv|ба даст овардан|достигать|erishmoq|to succeed in doing|You can achieve your goals.","schedule|ˈʃed.juːl|ҷадвал|расписание|jadval|a plan of times|My schedule is busy today.","invite|ɪnˈvaɪt|даъват кардан|приглашать|taklif etmoq|to ask to come|I invite you to dinner."],[
"reluctant|rɪˈlʌk.tənt|нохоҳон|неохотный|istamaydigan|unwilling|He was reluctant to answer.","ambiguous|æmˈbɪɡ.ju.əs|мубҳам|двусмысленный|noaniq|having two meanings|The answer was ambiguous.","resilient|rɪˈzɪl.i.ənt|тобовар|стойкий|chidamli|recovering quickly|Children are resilient.","inevitable|ɪˈnev.ɪ.tə.bəl|ногузир|неизбежный|muqarrar|certain to happen|Change is inevitable.","elaborate|ɪˈlæb.ər.ət|муфассал|сложный|murakkab|full of detail|They made an elaborate plan.","compelling|kəmˈpel.ɪŋ|бовармандкунанда|убедительный|ishonarli|very convincing|She gave a compelling speech.","mitigate|ˈmɪt.ɪ.ɡeɪt|сабук кардан|смягчать|yengillashtirmoq|to make less severe|Trees mitigate the heat.","pragmatic|præɡˈmæt.ɪk|воқеъбин|прагматичный|amaliy|practical|He takes a pragmatic approach.","scrutinize|ˈskruː.tɪ.naɪz|бодиққат санҷидан|тщательно изучать|sinchiklab tekshirmoq|to examine closely|Auditors scrutinize every report.","undermine|ˌʌn.dəˈmaɪn|заиф кардан|подрывать|putur yetkazmoq|to weaken|Gossip can undermine trust.","substantial|səbˈstæn.ʃəl|назаррас|существенный|sezilarli|large in amount|He made a substantial profit.","nuance|ˈnjuː.ɑːns|нозукӣ|нюанс|nozik farq|a subtle difference|Translation loses some nuance.","coherent|kəʊˈhɪə.rənt|мантиқӣ|связный|izchil|logical and clear|Write a coherent essay.","endeavour|ɪnˈdev.ər|кӯшиш|стремление|intilish|a serious attempt|Learning is a worthy endeavour.","prevalent|ˈprev.əl.ənt|густариш ёфта|распространённый|keng tarqalgan|widespread|Colds are prevalent in winter.","meticulous|məˈtɪk.jə.ləs|бодиққат|скрупулёзный|puxta|very careful|She is meticulous about details.","contemplate|ˈkɒn.təm.pleɪt|андеша кардан|размышлять|mulohaza qilmoq|to think deeply|I contemplate moving abroad.","paramount|ˈpær.ə.maʊnt|бениҳоят муҳим|первостепенный|eng muhim|most important|Safety is paramount."]
].map(l=>l.map(s=>{const[w,p,tg,ru,uz,d,e]=s.split("|");return{w,p,tg,ru,uz,d,e}}));

/* ===== HELPERS + STATE ===== */
const $=id=>document.getElementById(id), root=document.documentElement;
const shuffle=a=>{a=[...a];for(let i=a.length-1;i>0;i--){const j=Math.random()*(i+1)|0;[a[i],a[j]]=[a[j],a[i]]}return a};
let lvl=0; $("yr").textContent=new Date().getFullYear();

/* ===== THEME ===== */
function setTheme(t){root.dataset.theme=t;$("themeBtn").textContent=t==="dark"?"☀️":"🌙";try{localStorage.setItem("em-theme",t)}catch(e){}}
let st=null;try{st=localStorage.getItem("em-theme")}catch(e){}
setTheme(st||(matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light"));
$("themeBtn").onclick=()=>setTheme(root.dataset.theme==="dark"?"light":"dark");
$("menuBtn").onclick=()=>$("links").classList.toggle("open");
$("links").onclick=()=>$("links").classList.remove("open");

/* ===== HERO: rotating greeting ===== */
const G=["Hello","Салом","Привет","Salom"];let gi=0;
setInterval(()=>{const b=$("greet");b.classList.add("out");setTimeout(()=>{gi=(gi+1)%G.length;b.textContent=G[gi];b.classList.remove("out")},350)},2200);

/* ===== LEVEL CHIPS (shared by every section, always in sync) ===== */
function chips(){document.querySelectorAll(".lvls").forEach(el=>{
  el.innerHTML=LV.map((l,i)=>`<button class="chip ${i===lvl?"on":""}" data-l="${i}" aria-pressed="${i===lvl}">${l}<small>${LT[i]}</small></button>`).join("")})}
document.addEventListener("click",e=>{const c=e.target.closest(".chip");if(c){lvl=+c.dataset.l;renderAll()}});

/* ===== LESSONS ===== */
function lessons(){$("lessonGrid").innerHTML=LESSONS[lvl].map((l,i)=>`
 <article class="card" style="animation-delay:${i*80}ms"><h3>${l.t}</h3><p><b>${l.tj}</b><span>${l.d}</span></p>
 <div class="bar" role="progressbar" aria-valuenow="${l.p}"><div style="width:${l.p}%"></div></div>
 <div class="row"><span>${l.p}%</span><button data-i="${i}">${l.p>=100?"Done ✓":l.p?"Continue":"Start"}</button></div></article>`).join("")}
$("lessonGrid").onclick=e=>{const i=e.target.dataset.i;if(i===undefined)return;const l=LESSONS[lvl][i];l.p=Math.min(100,l.p+10);lessons()};

/* ===== DIALOGUE ===== */
function dialogue(){$("dlg").innerHTML=DIA[lvl].map((m,i)=>{const[en,tj]=m.split("|");
 return`<div class="msg" data-say="${en}" title="Click to listen" style="animation-delay:${i*90}ms"><span class="sp">🔊</span><b>${i%2?"B":"A"}:</b> ${en}<em>${tj}</em></div>`}).join("")}

/* ===== FLASHCARDS ===== */
function vocab(){const q=($("vs").value||"").trim().toLowerCase();const L=WORDS[lvl].filter(x=>!q||[x.w,x.tg,x.ru,x.uz].some(t=>t.toLowerCase().includes(q)));$("fg").innerHTML=!L.length?'<p class="tg">No words found · Калима ёфт нашуд</p>':L.map(x=>`<button class="fl" aria-label="Flip card ${x.w}"><div class="fi">
 <div class="fc f"><b>${x.w}</b><i>/${x.p}/ <span class="sp" role="button" tabindex="0" aria-label="Listen" data-say="${x.w}">🔊</span></i><small>Tap to flip · Пахш кунед</small></div>
 <div class="fc b"><b>${x.tg}</b><span>RU: ${x.ru} · UZ: ${x.uz}</span><span>${x.d}</span><em>“${x.e}”</em></div></div></button>`).join("")}
$("fg").onclick=e=>{const sp=e.target.closest(".sp");if(sp){speak(sp.dataset.say);return}const c=e.target.closest(".fl");if(c)c.classList.toggle("flip")};
$("vs").oninput=vocab;
$("dlg").onclick=e=>{const m=e.target.closest(".msg");if(m)speak(m.dataset.say)};
/* Pronunciation via the browser's built-in voice */
function speak(t){try{speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(t);u.lang="en-US";u.rate=.85;speechSynthesis.speak(u)}catch(e){}}
/* Anchor links: scroll with JS so they also work inside previews/iframes */
document.addEventListener("click",e=>{const a=e.target.closest('a[href^="#"]');if(!a||a.getAttribute("href")==="#")return;const t=document.querySelector(a.getAttribute("href"));if(t){e.preventDefault();t.scrollIntoView({behavior:"smooth"})}});
/* Back-to-top button */
addEventListener("scroll",()=>$("top").classList.toggle("show",scrollY>500));
$("top").onclick=()=>scrollTo({top:0,behavior:"smooth"});

/* ===== QUIZ: 50 questions per level, built from that level's vocabulary ===== */
let Q=[],qi=0,sc=0,done=false;
function buildQuiz(){
 const ws=WORDS[lvl],pool=[];ws.forEach(x=>[0,1,2,3,4].forEach(t=>pool.push([x,t])));
 Q=shuffle(pool).slice(0,50).map(([x,t])=>{
  const f=[["tg",`What is the Tajik for “${x.w}”?`],["w",`Which English word means “${x.tg}” (Tajik)?`],["w",`Which English word means “${x.ru}” (Russian)?`],["w","Complete the sentence: "+x.e.replace(new RegExp(x.w,"i"),"_____")],["w",`Which English word means “${x.uz}” (Uzbek)?`]][t];
  const key=t===0?"tg":"w",others=shuffle(ws.filter(o=>o!==x)).slice(0,3).map(o=>o[key]);
  const opts=shuffle([x[key],...others]);
  return{q:f[1],opts,a:opts.indexOf(x[key]),why:`${x.w} = ${x.tg} · ${x.ru} · ${x.uz}`}})}
function quiz(){const b=$("quiz");
 if(qi>=Q.length){const p=sc/Q.length;let best=sc;try{best=Math.max(sc,+localStorage.getItem("em-b"+lvl)||0);localStorage.setItem("em-b"+lvl,best)}catch(e){}b.innerHTML=`<div class="score"><b>${sc}/${Q.length}</b><p>${p>.9?"Excellent! · Аъло!":p>.6?"Good job! · Офарин!":"Keep practising · Идома диҳед"}</p><small class="tg">Best · Беҳтарин: ${best}/${Q.length}</small><br><br><button class="btn" id="again">Try again · Аз нав</button></div>`;
  $("again").onclick=startQuiz;return}
 const q=Q[qi];done=false;
 b.innerHTML=`<div class="qm"><span>${LV[lvl]} · ${qi+1}/${Q.length}</span><span>Score: ${sc}</span></div>
 <div class="bar"><div style="width:${qi/Q.length*100}%"></div></div><h3>${q.q}</h3>
 <div class="opts">${q.opts.map((o,i)=>`<button class="opt" data-i="${i}">${o}</button>`).join("")}</div>
 <div class="fb" id="fb" role="status"></div><button class="btn" id="next" style="display:none">${qi===Q.length-1?"See score":"Next"}</button>`;
 $("next").onclick=()=>{qi++;quiz()}}
$("quiz").addEventListener("click",e=>{const b=e.target.closest(".opt");if(!b||done)return;done=true;
 const q=Q[qi],p=+b.dataset.i;
 document.querySelectorAll(".opt").forEach((o,i)=>{o.disabled=true;if(i===q.a)o.classList.add("ok")});
 if(p===q.a){sc++;$("fb").textContent="Correct! · Дуруст! "+q.why;$("fb").style.color="#16a068"}
 else{b.classList.add("no");$("fb").textContent="Not quite · Нодуруст. "+q.why;$("fb").style.color="var(--bad)"}
 $("next").style.display="inline-block"});
function startQuiz(){qi=0;sc=0;buildQuiz();quiz()}

/* ===== RENDER EVERYTHING when the level changes ===== */
function renderAll(){root.dataset.lvl=lvl;chips();lessons();dialogue();vocab();startQuiz()}
renderAll();
</script>
</body>
</html>
